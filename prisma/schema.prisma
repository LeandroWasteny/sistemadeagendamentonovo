generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationTarget {
  CLIENT
  PROFESSIONAL
}

enum NotificationStatus {
  SENT
  FAILED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id                   String                @id @default(cuid())
  name                 String
  description          String
  durationMinutes      Int
  priceCents           Int
  promoPriceCents      Int?
  promoActive          Boolean               @default(false)
  promoDiscountPercent Int                   @default(0)
  promoStartsAt        DateTime?
  promoEndsAt          DateTime?
  sortOrder            Int                   @default(0)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  appointments         Appointment[]
  professionals        ProfessionalService[]

  @@index([active, sortOrder])
}

model Professional {
  id                String                 @id @default(cuid())
  name              String
  phone             String
  specialties       String
  photoUrl          String?
  commissionPercent Int                    @default(0)
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  schedules         ProfessionalSchedule[]
  appointments      Appointment[]
  services          ProfessionalService[]
}

model ProfessionalService {
  id             String       @id @default(cuid())
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([professionalId, serviceId])
  @@index([serviceId])
}

model ProfessionalSchedule {
  id              String       @id @default(cuid())
  professionalId  String
  dayOfWeek       Int
  startTime       String
  endTime         String
  intervalMinutes Int          @default(30)
  active          Boolean      @default(true)
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([professionalId, dayOfWeek, startTime, endTime])
}

model Appointment {
  id              String            @id @default(cuid())
  clientName      String
  clientPhone     String
  notes           String?
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(PENDING)
  priceCents      Int?
  discountCents   Int               @default(0)
  finalPriceCents Int?
  serviceId       String
  professionalId  String
  couponId        String?
  service         Service           @relation(fields: [serviceId], references: [id])
  professional    Professional      @relation(fields: [professionalId], references: [id])
  coupon          Coupon?           @relation(fields: [couponId], references: [id])
  notifications   NotificationLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([professionalId, startsAt])
  @@index([couponId])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  discountType   CouponDiscountType @default(PERCENT)
  discountValue  Int
  minAmountCents Int                @default(0)
  usageLimit     Int?
  usedCount      Int                @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean            @default(true)
  appointments   Appointment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([active, startsAt, endsAt])
}

model NotificationLog {
  id                String             @id @default(cuid())
  appointmentId     String
  appointment       Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  target            NotificationTarget
  status            NotificationStatus
  channel           String             @default("WHATSAPP")
  destination       String
  message           String
  providerMessageId String?
  error             String?
  createdAt         DateTime           @default(now())

  @@index([appointmentId, createdAt])
}

model WhatsappSession {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("DISCONNECTED")
  qrCode    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessProfile {
  id              String   @id
  businessName    String
  tagline         String
  logoUrl         String
  address         String
  whatsappUrl     String
  instagramUrl    String
  primaryColor    String   @default("#0F5EF7")
  primaryDark     String   @default("#082F8B")
  accentColor     String   @default("#22C55E")
  accentSoft      String   @default("#EAFBF1")
  backgroundColor String   @default("#F6F9FF")
  surfaceColor    String   @default("#FFFFFF")
  textColor       String   @default("#082F8B")
  mutedColor      String   @default("#64748B")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
